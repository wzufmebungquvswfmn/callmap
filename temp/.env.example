# 使用环境变量或 secret 文件，两者配置时环境变量优先。
# FLUX_SERVICE_SECRET=replace-with-service-account-secret
FLUX_SERVICE_SECRET_FILE=../secret

# 实验补取默认关闭，仅当请求传 include_raw_spans=true、recover_raw_spans=true 时使用。
# 预算：最多 8 个候选、60 秒、累计 256 MiB。
# 单个候选不做瞬时故障重试；JWT 被拒绝时仍允许一次认证刷新。
FLUX_RAW_RECOVERY_MAX_SESSIONS=8
FLUX_RAW_RECOVERY_TIMEOUT_SECONDS=60
FLUX_RAW_RECOVERY_MAX_BYTES=268435456
FLUX_BASE_URL=https://flux-insight.byted.org
FLUX_IAM_URL=https://cloud.bytedance.net/auth/api/v1/jwt
FLUX_REQUESTS_PER_SECOND=8
FLUX_REQUEST_TIMEOUT_SECONDS=30
FLUX_QUERY_TIMEOUT_SECONDS=120
FLUX_MAX_PAGES=100
FLUX_MAX_TASK_IDS=10000
FLUX_MAX_CONCURRENT_QUERIES=4
FLUX_OPTIONS_CACHE_TTL_SECONDS=60
FLUX_OPTIONS_CACHE_SIZE=128
FLUX_OPTIONS_PAGES_PER_BATCH=5
FLUX_OPTIONS_QUERY_TIMEOUT_SECONDS=20
# 设置后查询接口需要 Authorization: Bearer <此值>
# FLUX_API_KEY=replace-with-api-key
FLUX_HOST=127.0.0.1
FLUX_PORT=18080

# Fornax 仅作为 Trace/metrics 兜底，使用个人 JWT，不复用服务账号 secret。
# 默认由外部更新文件；收到 401 时重新读取一次。
# 本机可启用 Chrome SSO 刷新，启动时加 --extra desktop。
FLUX_FORNAX_REFRESH_FROM_CHROME=false
# FLUX_FORNAX_JWT=replace-with-personal-jwt
FLUX_FORNAX_JWT_FILE=../jwt
FLUX_FORNAX_BASE_URL=https://fornax.bytedance.net
FLUX_FORNAX_WORKSPACE_ID=7590084809894139650
FLUX_FORNAX_PLATFORM=inner_cozeloop
FLUX_FORNAX_RANGE_DAYS=120
FLUX_FORNAX_MIN_INTERVAL_SECONDS=1.1
FLUX_EXPORT_DIR=exports/jobs
FLUX_MAX_EXPORT_JOBS=4
FLUX_MAX_TAGGING_JOBS=2
FLUX_EXPORT_TASK_TIMEOUT_SECONDS=600
FLUX_ARTIFACT_RECOVERY_TIMEOUT_SECONDS=60
FLUX_MAX_DOWNLOAD_BYTES=268435456
FLUX_MAX_EXPORT_BYTES=2147483648
