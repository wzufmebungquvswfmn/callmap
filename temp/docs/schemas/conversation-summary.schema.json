{
  "properties": {
    "schema_version": {
      "default": "1.0",
      "pattern": "^1\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "complete": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Complete"
    },
    "content_available": {
      "title": "Content Available",
      "type": "boolean"
    },
    "files": {
      "items": {
        "type": "string"
      },
      "title": "Files",
      "type": "array"
    },
    "errors": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Errors",
      "type": "array"
    }
  },
  "required": [
    "source",
    "complete",
    "content_available",
    "files",
    "errors"
  ],
  "title": "ConversationPayload",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
