      "title": "MetricValues",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "1.0",
      "pattern": "^1\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "enum": [
        "flux_insight_openapi",
        "fornax",
        "task_detail"
      ],
      "title": "Source",
      "type": "string"
    },
    "complete": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Complete"
    },
    "values": {
      "$ref": "#/$defs/MetricValues"
    },
    "warnings": {
