    },
    "total_latency_complete": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Latency Complete"
    },
    "first_response_complete": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "First Response Complete"
    },
    "tokens_available": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tokens Available"
    },
    "tokens_complete": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tokens Complete"
    },
    "timing_complete": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Timing Complete"
    },
    "turn_timing_complete": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Turn Timing Complete"
    },
    "first_response_available": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "First Response Available"
    }
  },
  "required": [
    "source",
    "complete",
    "values",
    "warnings"
  ],
  "title": "MetricsPayload",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
